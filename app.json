{
  "expo": {
    "name": "GilTube",
    "slug": "giltube",
    "version": "0.9.48",
    "scheme": "giltube",
    "icon": "./assets/images/giltube-icon-safe.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.gilservers.giltube",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "GilTube uses your camera to broadcast live video.",
        "NSMicrophoneUsageDescription": "GilTube uses your microphone to broadcast live audio."
      }
    },
    "android": {
      "package": "com.gilservers.giltube",
      "versionCode": 62,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "http", "host": "giltube.gilservers.com" },
            { "scheme": "https", "host": "giltube.gilservers.com" },
            { "path": "/" },
            { "path": "/account-settings" },
            { "path": "/create-channel" },
            { "path": "/dashboard" },
            { "path": "/go-live" },
            { "path": "/my-channels" },
            { "path": "/playback-settings" },
            { "path": "/search" },
            { "path": "/settings" },
            { "path": "/subscriptions" },
            { "path": "/upload" },
            { "pathPrefix": "/category/" },
            { "pathPrefix": "/channel" },
            { "pathPrefix": "/live" },
            { "pathPrefix": "/movies" },
            { "pathPrefix": "/music" },
            { "pathPrefix": "/news/" },
            { "pathPrefix": "/notification" },
            { "pathPrefix": "/playlist" },
            { "pathPrefix": "/series" },
            { "pathPrefix": "/themes" },
            { "pathPrefix": "/video/" },
            { "pathPrefix": "/watch-part" },
            { "path": "/es" },
            { "path": "/es/" },
            { "path": "/es/account-settings" },
            { "path": "/es/create-channel" },
            { "path": "/es/dashboard" },
            { "path": "/es/go-live" },
            { "path": "/es/my-channels" },
            { "path": "/es/playback-settings" },
            { "path": "/es/search" },
            { "path": "/es/settings" },
            { "path": "/es/subscriptions" },
            { "path": "/es/upload" },
            { "pathPrefix": "/es/category/" },
            { "pathPrefix": "/es/channel" },
            { "pathPrefix": "/es/live" },
            { "pathPrefix": "/es/movies" },
            { "pathPrefix": "/es/music" },
            { "pathPrefix": "/es/news/" },
            { "pathPrefix": "/es/notification" },
            { "pathPrefix": "/es/playlist" },
            { "pathPrefix": "/es/series" },
            { "pathPrefix": "/es/themes" },
            { "pathPrefix": "/es/video/" },
            { "pathPrefix": "/es/watch-part" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/giltube-icon-safe.png",
        "backgroundColor": "#FF0000"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@config-plugins/react-native-webrtc",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/giltube-icon-safe.png",
          "color": "#ef4444",
          "defaultChannel": "giltube"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
